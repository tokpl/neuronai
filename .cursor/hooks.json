{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/neuron-gate.mjs",
        "matcher": "Write|StrReplace|EditNotebook|Delete|ApplyPatch",
        "failClosed": true
      }
    ],
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/neuron-gate.mjs",
        "failClosed": false
      }
    ]
  }
}
