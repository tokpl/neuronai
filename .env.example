# Neuron AI Memory — environment template

# --- Database (optional; local JSON works without it) ---
DATABASE_URL=postgresql://neuron:neuron@localhost:5432/neuron

# --- Runtime ---
LOG_LEVEL=info
NODE_ENV=development
NEURON_MODE=local
# NEURON_API_KEY=   # required only when NEURON_MODE=cloud
# NEURON_PRIVACY_MODE=suggest
# NEURON_CWD=/absolute/path/to/project
# NEURON_CONFIG_PATH=./neuron.config.json

# --- Optional AI providers (never commit real keys) ---
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Telemetry (default OFF; also requires in-app consent) ---
# NEURON_TELEMETRY=0
