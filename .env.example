# Neuron is local-first. No database or AI API key is required for the default Cursor loop.
#
# Optional overrides (all optional):

# NEURON_CWD=/path/to/project
# NEURON_PRIVACY_MODE=suggest
# NEURON_EXPERIMENTAL=1

# Future / experimental only (not used by MVP):
# DATABASE_URL=postgresql://neuron:neuron@localhost:5432/neuron
# OPENAI_API_KEY=
