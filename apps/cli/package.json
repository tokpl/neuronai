{
  "name": "@neuron-ai-memory/cli",
  "version": "0.1.0",
  "description": "CLI for Neuron — local-first project memory for Cursor",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "neuron": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public",
    "name": "neuron"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neuron-ai-memory/ai-memory": "workspace:*",
    "@neuron-ai-memory/ai-provider": "workspace:*",
    "@neuron-ai-memory/agent-workflow": "workspace:*",
    "@neuron-ai-memory/config": "workspace:*",
    "@neuron-ai-memory/cursor-integration": "workspace:*",
    "@neuron-ai-memory/embeddings": "workspace:*",
    "@neuron-ai-memory/mcp-server": "workspace:*",
    "@neuron-ai-memory/memory-engine": "workspace:*",
    "@neuron-ai-memory/observability": "workspace:*",
    "@neuron-ai-memory/project-analyzer": "workspace:*",
    "@neuron-ai-memory/project-scanner": "workspace:*",
    "@neuron-ai-memory/retrieval-engine": "workspace:*",
    "@neuron-ai-memory/security": "workspace:*",
    "@neuron-ai-memory/storage": "workspace:*",
    "@neuron-ai-memory/types": "workspace:*",
    "cac": "^6.7.14",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
