{
  "name": "neuronai",
  "version": "0.1.3",
  "description": "NeuronAI - CLI for Neuron - AI Memory (local-first Cursor project memory)",
  "license": "AGPL-3.0",
  "type": "module",
  "bin": {
    "neuronai": "./dist/index.js",
    "neuron": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tokpl/neuronai.git"
  },
  "homepage": "https://github.com/tokpl/neuronai",
  "bugs": {
    "url": "https://github.com/tokpl/neuronai/issues"
  },
  "keywords": [
    "NeuronAI",
    "neuronai",
    "Neuron - AI Memory",
    "cursor",
    "mcp",
    "ai-memory",
    "local-first"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@neuronai/ai-memory": "workspace:*",
    "@neuronai/ai-provider": "workspace:*",
    "@neuronai/agent-workflow": "workspace:*",
    "@neuronai/config": "workspace:*",
    "@neuronai/cursor-integration": "workspace:*",
    "@neuronai/embeddings": "workspace:*",
    "@neuronai/mcp-server": "workspace:*",
    "@neuronai/memory-engine": "workspace:*",
    "@neuronai/observability": "workspace:*",
    "@neuronai/project-analyzer": "workspace:*",
    "@neuronai/project-scanner": "workspace:*",
    "@neuronai/retrieval-engine": "workspace:*",
    "@neuronai/security": "workspace:*",
    "@neuronai/storage": "workspace:*",
    "@neuronai/types": "workspace:*",
    "cac": "^6.7.14",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
