{
  "name": "@neuronai/mcp-server",
  "version": "0.2.6",
  "description": "NeuronAI / mcp-server - package for Neuron - AI Memory",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "@neuronai/agent-workflow": "workspace:*",
    "@neuronai/brain": "workspace:*",
    "@neuronai/project-scanner": "workspace:*",
    "@neuronai/storage": "workspace:*",
    "@neuronai/types": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tokpl/neuronai.git"
  },
  "homepage": "https://github.com/tokpl/neuronai",
  "bugs": {
    "url": "https://github.com/tokpl/neuronai/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "private": true
}
