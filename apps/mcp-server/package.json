{
  "name": "@neuronai/mcp-server",
  "version": "0.1.0",
  "description": "Neuron MCP server - local project memory for Cursor",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "name": "@neuronai/mcp-server"
  },
  "bin": {
    "neuron-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0",
    "@neuronai/ai-memory": "workspace:*",
    "@neuronai/ai-provider": "workspace:*",
    "@neuronai/agent-intelligence": "workspace:*",
    "@neuronai/agent-workflow": "workspace:*",
    "@neuronai/config": "workspace:*",
    "@neuronai/cursor-integration": "workspace:*",
    "@neuronai/embeddings": "workspace:*",
    "@neuronai/knowledge-graph": "workspace:*",
    "@neuronai/memory-engine": "workspace:*",
    "@neuronai/observability": "workspace:*",
    "@neuronai/project-analyzer": "workspace:*",
    "@neuronai/project-scanner": "workspace:*",
    "@neuronai/retrieval-engine": "workspace:*",
    "@neuronai/storage": "workspace:*",
    "@neuronai/types": "workspace:*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
