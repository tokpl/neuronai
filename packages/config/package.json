{
  "name": "@neuronai/config",
  "version": "0.2.2",
  "description": "NeuronAI / config - package for Neuron - AI Memory",
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
